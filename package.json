{
  "name": "@b8safe/react-native-safe",
  "version": "1.0.23",
  "description": "Package for native integration of B8Safe SDK",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "android",
    "ios",
    "cpp",
    "app.plugin.js",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typescript": "tsc --noEmit false",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "build": "bob build",
    "release": "bob build && release-it",
    "commit": "git-cz",
    "clean-js": "scripts/clean-js.sh"
  },
  "keywords": [
    "liveness",
    "b8safe",
    "facial",
    "react-native",
    "ios",
    "android",
    "kyc",
    "compliance",
    "safe"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brbtcoficial/react-native-b8safe.git"
  },
  "author": "B8 Hub <safe@b8.com.br> (https://safe.b8.com.br)",
  "license": "BSD-2-Clause",
  "bugs": {
    "url": "https://github.com/brbtcoficial/react-native-b8safe/issues"
  },
  "homepage": "https://github.com/brbtcoficial/react-native-safe/tree/v2/Documentation",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@expo/config-plugins": "^8.0.5",
    "@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
    "@react-native/eslint-config": "^0.75.4",
    "@react-native/typescript-config": "^0.75.4",
    "@release-it/conventional-changelog": "^8.0.1",
    "@shopify/react-native-skia": "^1.4.2",
    "@types/react": "^18.3.3",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.0.1",
    "react": "^18.3.1",
    "react-native": "^0.75.4",
    "react-native-builder-bob": "^0.23.2",
    "react-native-reanimated": "^3.15.5",
    "react-native-svg": "^15.10.1",
    "react-native-vision-camera": "^4.6.3",
    "react-native-worklets-core": "^1.3.3",
    "release-it": "^17.3.0",
    "typescript": "^5.1.6"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-sha256": "*",
    "react-native-svg": "*",
    "react-native-vision-camera": ">=3",
    "react-native-webrtc": "*",
    "react-native-worklets-core": "*"
  },
  "peerDependenciesMeta": {
    "react-native-reanimated": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "✨ Features"
            },
            {
              "type": "perf",
              "section": "💨 Performance Improvements"
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes"
            },
            {
              "type": "chore(deps)",
              "section": "🛠️ Dependency Upgrades"
            },
            {
              "type": "docs",
              "section": "📚 Documentation"
            }
          ]
        }
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  }
}
